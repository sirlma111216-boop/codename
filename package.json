{
  "name": "codename",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "코드네임 기본판 실시간 웹앱 (비공식 모임용 구현) — Cloudflare Workers + Durable Objects",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n client,worker -c blue,magenta \"vite build --watch --mode development\" \"wrangler dev --port 8787\"",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.client.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "content:verify": "node --experimental-strip-types --no-warnings scripts/content-verify.ts",
    "content:import": "node --experimental-strip-types --no-warnings scripts/content-import.ts",
    "assets:build": "node scripts/build-assets.mjs",
    "release:check": "node --experimental-strip-types --no-warnings scripts/release-check.ts",
    "deploy": "npm run build && wrangler deploy",
    "deploy:staging": "npm run build && wrangler deploy --env staging",
    "cf-typegen": "wrangler types src/server/worker-configuration.d.ts",
    "test:class-sim": "node --experimental-strip-types --no-warnings tests/load/class-sim.ts"
  },
  "dependencies": {
    "qrcode-generator": "2.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260924.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "sharp": "0.35.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.1",
    "wrangler": "4.138.0",
    "ws": "8.21.3"
  }
}
